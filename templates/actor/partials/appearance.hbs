<div class="section appearance {{system.creatureType}} flexcol">
    <div class="section-header">
        <div class="section-title">{{localize 'MYZ-ALT.APPEARANCE.LABEL'}}</div>
    </div>
    <div class="section-row flexrow light-bg">
        <div class="section-column flexcol flex-basis-10">
            <strong>{{localize 'MYZ-ALT.APPEARANCE.FACE'}}:</strong>
        </div>
        <div class="section-column flexcol flex-basis-90">
            {{#if editable}}
            <prose-mirror name="flags.myz-alt-sheet.appearance.face" data-document-uuid="{{actor.uuid}}" value="{{appearance.face}}" toggled="true">{{{enriched.face}}}</prose-mirror>
            {{else}}<div class="rich-text">{{{enriched.face}}}</div>{{/if}}
        </div>
    </div>
    <div class="section-row flexrow light-bg">
        <div class="section-column flexcol flex-basis-10">
            <strong>{{localize 'MYZ-ALT.APPEARANCE.BODY'}}:</strong>
        </div>
        <div class="section-column flexcol flex-basis-90">
            {{#if editable}}
            <prose-mirror name="flags.myz-alt-sheet.appearance.body" data-document-uuid="{{actor.uuid}}" value="{{appearance.body}}" toggled="true">{{{enriched.body}}}</prose-mirror>
            {{else}}<div class="rich-text">{{{enriched.body}}}</div>{{/if}}
        </div>
    </div>
    <div class="section-row flexrow light-bg">
        <div class="section-column flexcol flex-basis-10">
            <strong>{{localize 'MYZ-ALT.APPEARANCE.CLOTHING'}}:</strong>
        </div>
        <div class="section-column flexcol flex-basis-90">
            {{#if editable}}
            <prose-mirror name="flags.myz-alt-sheet.appearance.clothing" data-document-uuid="{{actor.uuid}}" value="{{appearance.clothing}}" toggled="true">{{{enriched.clothing}}}</prose-mirror>
            {{else}}<div class="rich-text">{{{enriched.clothing}}}</div>{{/if}}
        </div>
    </div>
</div>