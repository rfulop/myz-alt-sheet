<div class="section artifacts {{system.creatureType}} flexcol">
    <div class="section-header">
        <div class="section-title">{{localize "MYZ.ARTIFACTS"}}</div>
        <div class="section-control flex0">
            <a class="item-create" data-type="artifact" data-action="createItem">+</a>
        </div>
    </div>
    <ol class="item-list">
        {{#each artifacts as |artifact key|}}
            <li class="editable-item section-row-img gear flexrow light-bg box-item draggable" data-physical="1" data-item-id="{{artifact._id}}">
                <img class="section-img" src="{{artifact.img}}"  alt="{{artifact.name}}"/>
                <div class="viewable section-name" data-item-id="{{artifact._id}}" data-action="viewItem">
                    {{artifact.name}}
                </div>
                <div class="section-control flex0">
                    <span>{{artifact.system.weight}}</span>
                    <i class="fas fa-weight-hanging"></i>
                    <a class="item-stash-toggle" title='{{#if artifact.system.stashed}}{{localize "MYZ.UN_STASH_ITEM"}}{{else}}{{localize "MYZ.STASH"}}{{/if}}'  data-action="toggleItem" data-linked-value="system.stashed">
                            <i class="fa-regular fa-box"></i>
                        </a>
                    <a class="chatable" data-item-id="{{artifact._id}}" title="{{localize 'MYZ.TOCHAT'}}" data-action="sendToChat">
                        <i class="fas fa-comment"></i>
                    </a>
                </div>
            </li>
        {{/each}}
        {{#each (myzAltRange artifacts.length 2)}}
            <li class="section-row flexrow light-bg"></li>
        {{/each}}
    </ol>
</div>