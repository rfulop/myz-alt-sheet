<div class="section player-notes {{system.creatureType}} flexcol">
    <div class="section-header">
        <div class="section-title">{{localize 'MYZ-ALT.NOTES'}}</div>
    </div>
    <div class="section-notes light-bg">
        {{#if editable}}
            <prose-mirror name="system.notes" data-document-uuid="{{actor.uuid}}" value="{{system.notes}}" toggled="true">{{{enriched.notes}}}</prose-mirror>
            {{else}}<div class="rich-text">{{{enriched.notes}}}</div>{{/if}}
    </div>
</div>